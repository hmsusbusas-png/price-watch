# Telegram: токен выдаёт @BotFather, id чата можно узнать у @userinfobot. Оставьте пустыми, если уведомления не нужны.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Как часто проверять в режиме watch и на сколько процентов должна упасть цена, чтобы пришло уведомление
CHECK_INTERVAL_MINUTES=60
ALERT_DROP_PERCENT=5

# Где хранить историю
PRICEWATCH_DB=data/pricewatch.db
